<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:ShopLedger.Services"
             xmlns:c="clr-namespace:ShopLedger.Controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="ShopLedger.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <loc:FormatConverter x:Key="Fmt" />
            <c:InitialsConverter x:Key="Initials" />
            <c:NonZeroConverter x:Key="NonZero" />
            <c:IsZeroConverter x:Key="IsZero" />
            <toolkit:InvertedBoolConverter x:Key="Not" />
            <toolkit:IsStringNotNullOrEmptyConverter x:Key="HasText" />
            <toolkit:IsNotNullConverter x:Key="NotNull" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
