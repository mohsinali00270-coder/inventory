<?xml version="1.0" encoding="UTF-8" ?>
<!-- Navigation: phones get a bottom tab bar; tablets and desktop (wide windows) get a locked navy sidebar.
     AppShell.xaml.cs switches between the two as the window size changes. -->
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:loc="clr-namespace:ShopLedger.Services"
       xmlns:c="clr-namespace:ShopLedger.Controls"
       xmlns:views="clr-namespace:ShopLedger.Views"
       x:Class="ShopLedger.AppShell" Title="{loc:Translate X_shopledger}"
       FlyoutBehavior="Disabled" FlyoutWidth="260"
       FlyoutBackground="{StaticResource SidebarGradient}"
       Shell.NavBarHasShadow="False">

  <Shell.Resources>
    <Style TargetType="Element" ApplyToDerivedTypes="True" x:Key="ShellBase">
      <Setter Property="Shell.BackgroundColor" Value="{StaticResource Navy}" />
      <Setter Property="Shell.ForegroundColor" Value="White" />
      <Setter Property="Shell.TitleColor" Value="White" />
      <Setter Property="Shell.DisabledColor" Value="#7C8BA8" />
      <Setter Property="Shell.UnselectedColor" Value="#B6C2D9" />
      <Setter Property="Shell.TabBarBackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
      <Setter Property="Shell.TabBarForegroundColor" Value="{AppThemeBinding Light={StaticResource Royal}, Dark={StaticResource RoyalOnDark}}" />
      <Setter Property="Shell.TabBarTitleColor" Value="{AppThemeBinding Light={StaticResource Royal}, Dark={StaticResource RoyalOnDark}}" />
      <Setter Property="Shell.TabBarUnselectedColor" Value="{AppThemeBinding Light={StaticResource InkMutedLight}, Dark={StaticResource InkMutedDark}}" />
    </Style>
    <Style TargetType="ShellItem" BasedOn="{StaticResource ShellBase}" ApplyToDerivedTypes="True" />
  </Shell.Resources>

  <!-- Sidebar header: brand -->
  <Shell.FlyoutHeader>
    <Grid Padding="20,28,20,20" ColumnDefinitions="Auto,*" ColumnSpacing="12">
      <Border WidthRequest="44" HeightRequest="44" StrokeThickness="0" StrokeShape="RoundRectangle 12"
              Background="{StaticResource TealGradient}">
        <Label Text="{x:Static c:Icons.NotebookPen}" FontFamily="Icons" FontSize="22" TextColor="White"
               HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
      </Border>
      <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0">
        <Label Text="{loc:Translate X_shopledger}" TextColor="White" FontSize="19" FontAttributes="Bold" FontFamily="{DynamicResource AppFont}" />
        <Label Text="{loc:Translate UI_Tagline}" TextColor="#9FB0CF" FontSize="12" FontFamily="{DynamicResource AppFont}" />
      </VerticalStackLayout>
    </Grid>
  </Shell.FlyoutHeader>

  <!-- Sidebar item: icon + title, royal pill when selected -->
  <Shell.ItemTemplate>
    <DataTemplate>
      <Grid Padding="12,3" SemanticProperties.Description="{Binding Title}">
        <Border x:Name="Pill" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="14,11" BackgroundColor="Transparent">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
            <!-- glyph text (not an Image) so it survives the WinUI pane switching between docked and overlay -->
            <Label Text="{Binding FlyoutIcon.Glyph}" FontFamily="Icons" FontSize="20" TextColor="White" WidthRequest="22"
                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center" AutomationProperties.IsInAccessibleTree="False" />
            <Label Grid.Column="1" Text="{Binding Title}" TextColor="White" FontSize="15" VerticalTextAlignment="Center" FontFamily="{DynamicResource AppFont}" />
          </Grid>
        </Border>
        <VisualStateManager.VisualStateGroups>
          <VisualStateGroupList>
            <VisualStateGroup x:Name="CommonStates">
              <VisualState x:Name="Normal">
                <VisualState.Setters>
                  <Setter TargetName="Pill" Property="Border.BackgroundColor" Value="Transparent" />
                  <Setter TargetName="Pill" Property="Border.Opacity" Value="0.78" />
                </VisualState.Setters>
              </VisualState>
              <VisualState x:Name="Selected">
                <VisualState.Setters>
                  <Setter TargetName="Pill" Property="Border.BackgroundColor" Value="{StaticResource Royal}" />
                  <Setter TargetName="Pill" Property="Border.Opacity" Value="1" />
                </VisualState.Setters>
              </VisualState>
            </VisualStateGroup>
          </VisualStateGroupList>
        </VisualStateManager.VisualStateGroups>
      </Grid>
    </DataTemplate>
  </Shell.ItemTemplate>

  <Shell.FlyoutFooter>
    <VerticalStackLayout Padding="20,16" Spacing="6">
      <BoxView HeightRequest="1" Color="#22345C" Margin="0,0,0,8" />
      <HorizontalStackLayout Spacing="8">
        <Label Text="{x:Static c:Icons.CheckCircle}" FontFamily="Icons" FontSize="14" TextColor="{StaticResource TealOnDark}" VerticalTextAlignment="Center" />
        <Label Text="{loc:Translate UI_Offline}" TextColor="#9FB0CF" FontSize="12" FontFamily="{DynamicResource AppFont}" VerticalTextAlignment="Center" LineBreakMode="WordWrap" MaximumWidthRequest="200" />
      </HorizontalStackLayout>
    </VerticalStackLayout>
  </Shell.FlyoutFooter>

  <FlyoutItem Route="main" FlyoutDisplayOptions="AsMultipleItems">
    <ShellContent Title="{loc:Translate X_dashboard}" Route="dashboard" ContentTemplate="{DataTemplate views:DashboardPage}">
      <ShellContent.Icon><FontImageSource FontFamily="Icons" Glyph="{x:Static c:Icons.Dashboard}" Color="White" Size="22" /></ShellContent.Icon>
    </ShellContent>
    <ShellContent Title="{loc:Translate X_sales}" Route="sales" ContentTemplate="{DataTemplate views:SalesPage}">
      <ShellContent.Icon><FontImageSource FontFamily="Icons" Glyph="{x:Static c:Icons.Receipt}" Color="White" Size="22" /></ShellContent.Icon>
    </ShellContent>
    <ShellContent Title="{loc:Translate X_products}" Route="products" ContentTemplate="{DataTemplate views:ProductsPage}">
      <ShellContent.Icon><FontImageSource FontFamily="Icons" Glyph="{x:Static c:Icons.Package}" Color="White" Size="22" /></ShellContent.Icon>
    </ShellContent>
    <ShellContent Title="{loc:Translate X_customers}" Route="customers" ContentTemplate="{DataTemplate views:CustomersPage}">
      <ShellContent.Icon><FontImageSource FontFamily="Icons" Glyph="{x:Static c:Icons.Users}" Color="White" Size="22" /></ShellContent.Icon>
    </ShellContent>
    <ShellContent Title="{loc:Translate X_settings}" Route="settings" ContentTemplate="{DataTemplate views:SettingsPage}">
      <ShellContent.Icon><FontImageSource FontFamily="Icons" Glyph="{x:Static c:Icons.Settings}" Color="White" Size="22" /></ShellContent.Icon>
    </ShellContent>
  </FlyoutItem>
</Shell>
