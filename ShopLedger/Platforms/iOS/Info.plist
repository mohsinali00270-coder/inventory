<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIDeviceFamily</key>
	<array><integer>1</integer><integer>2</integer></array>
	<key>UIRequiredDeviceCapabilities</key>
	<array><string>arm64</string></array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>XSAppIconAssets</key>
	<string>Assets.xcassets/appicon.appiconset</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>ShopLedger uses the microphone so you can add entries by voice.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>ShopLedger uses speech recognition to turn your voice into entries.</string>
	<key>NSCameraUsageDescription</key>
	<string>ShopLedger uses the camera to take product photos.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>ShopLedger lets you choose product photos from your library.</string>
</dict>
</plist>
