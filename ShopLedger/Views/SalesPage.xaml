<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:ShopLedger.Services" xmlns:c="clr-namespace:ShopLedger.Controls"
             x:Class="ShopLedger.Views.SalesPage" Title="{loc:Translate X_sales}">
  <ContentPage.ToolbarItems>
    <ToolbarItem Text="{loc:Translate X_history}" Clicked="OnHistoryClicked" />
    <ToolbarItem Text="{loc:Translate X_read}" Clicked="OnSpeakClicked" />
    <ToolbarItem Text="{loc:Translate X_stop}" Clicked="OnStopClicked" />
  </ContentPage.ToolbarItems>

  <CollectionView ItemsSource="{Binding Recent}" Margin="16,0">
    <CollectionView.Header>
      <VerticalStackLayout Spacing="12" Padding="0,16,0,12" MaximumWidthRequest="1240">
        <Label Text="{loc:Translate UI_QuickActions}" Style="{StaticResource Overline}" />
        <c:AdaptiveGrid MinColumnWidth="160" MaxColumns="5" ColumnSpacing="10" RowSpacing="10">
          <c:ActionTile Icon="{x:Static c:Icons.Cart}" Tone="Info" Text="{loc:Translate X_new_sale}" Command="{Binding NewSaleCommand}" />
          <c:ActionTile Icon="{x:Static c:Icons.HandCoins}" Tone="Teal" Text="{loc:Translate X_receive_payment}" Command="{Binding ReceivePaymentCommand}" />
          <c:ActionTile Icon="{x:Static c:Icons.NotebookPen}" Tone="Neutral" Text="{loc:Translate X_manual_entry}" Command="{Binding ManualEntryCommand}" />
          <c:ActionTile Icon="{x:Static c:Icons.Truck}" Tone="Warning" Text="{loc:Translate X_stock_purchase}" Command="{Binding NewPurchaseCommand}" />
          <c:ActionTile Icon="{x:Static c:Icons.Mic}" Tone="Info" Text="{loc:Translate X_voice_entry}" Command="{Binding VoiceEntryCommand}" />
        </c:AdaptiveGrid>
        <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
          <Label Text="{loc:Translate X_recent_activity}" Style="{StaticResource H2}" VerticalOptions="Center" SemanticProperties.HeadingLevel="Level2" />
          <Button Grid.Column="1" Text="{loc:Translate X_history}" Style="{StaticResource SmallButton}" Clicked="OnHistoryClicked" />
        </Grid>
        <c:StateBanner IsBusy="{Binding IsBusy}" Error="{Binding Error}" RetryCommand="{Binding LoadCommand}" />
        <c:EmptyState IsVisible="{Binding Recent.Count, Converter={StaticResource IsZero}}" Icon="{x:Static c:Icons.Receipt}" Title="{loc:Translate UI_NoActivity}" Message="{loc:Translate X_no_transactions_yet}" />
      </VerticalStackLayout>
    </CollectionView.Header>
    <CollectionView.Footer><BoxView HeightRequest="16" Color="Transparent" /></CollectionView.Footer>
    <CollectionView.ItemTemplate>
      <DataTemplate>
        <Border Style="{StaticResource ListCard}" Padding="12" Margin="0,0,0,8" MaximumWidthRequest="1240">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Border Style="{StaticResource IconChip}">
              <Border.Triggers>
                <DataTrigger TargetType="Border" Binding="{Binding IsMoneyIn}" Value="True">
                  <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#CCFBF1, Dark=#0D3A36}" />
                </DataTrigger>
              </Border.Triggers>
              <Label Text="{x:Static c:Icons.Receipt}" Style="{StaticResource Icon}" FontSize="19"
                     TextColor="{AppThemeBinding Light={StaticResource Royal}, Dark={StaticResource RoyalOnDark}}">
                <Label.Triggers>
                  <DataTrigger TargetType="Label" Binding="{Binding IsMoneyIn}" Value="True">
                    <Setter Property="Text" Value="{x:Static c:Icons.ArrowIn}" />
                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TealDark}, Dark={StaticResource TealOnDark}}" />
                  </DataTrigger>
                </Label.Triggers>
              </Label>
            </Border>
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
              <Label Text="{Binding Title}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
              <Label Text="{Binding Subtitle}" Style="{StaticResource Caption}" LineBreakMode="TailTruncation" />
            </VerticalStackLayout>
            <Label Grid.Column="2" Text="{Binding Amount, Converter={StaticResource Fmt}, ConverterParameter=T_rs}" Style="{StaticResource Money}" VerticalOptions="Center">
              <Label.Triggers>
                <DataTrigger TargetType="Label" Binding="{Binding IsMoneyIn}" Value="True">
                  <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessOnDark}}" />
                </DataTrigger>
              </Label.Triggers>
            </Label>
          </Grid>
        </Border>
      </DataTemplate>
    </CollectionView.ItemTemplate>
  </CollectionView>
</ContentPage>
