<?xml version="1.0" encoding="UTF-8" ?>
<!-- ShopLedger design tokens. Brand: deep navy, royal blue, vibrant teal on soft white / subtle gray.
     Every surface/text colour has a light and a dark value; styles pick them with AppThemeBinding. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

  <!-- Brand -->
  <Color x:Key="Navy">#14213D</Color>
  <Color x:Key="NavyDeep">#0C1529</Color>
  <Color x:Key="NavyLight">#22345C</Color>
  <Color x:Key="Royal">#2563EB</Color>
  <Color x:Key="RoyalDark">#1D4ED8</Color>
  <Color x:Key="RoyalOnDark">#60A5FA</Color>
  <Color x:Key="Teal">#14B8A6</Color>
  <Color x:Key="TealDark">#0F766E</Color>
  <Color x:Key="TealOnDark">#2DD4BF</Color>
  <Color x:Key="SoftWhite">#F8FAFC</Color>
  <Color x:Key="SubtleGray">#E2E8F0</Color>

  <!-- Surfaces: light -->
  <Color x:Key="PageLight">#F8FAFC</Color>
  <Color x:Key="SurfaceLight">#FFFFFF</Color>
  <Color x:Key="SurfaceAltLight">#F1F5F9</Color>
  <Color x:Key="LineLight">#E2E8F0</Color>
  <!-- Surfaces: dark -->
  <Color x:Key="PageDark">#0B1220</Color>
  <Color x:Key="SurfaceDark">#111B2E</Color>
  <Color x:Key="SurfaceAltDark">#17233A</Color>
  <Color x:Key="LineDark">#24324D</Color>

  <!-- Text (all meet WCAG AA on their surface) -->
  <Color x:Key="InkLight">#0F172A</Color>
  <Color x:Key="InkSecondaryLight">#475569</Color>
  <Color x:Key="InkMutedLight">#64748B</Color>
  <Color x:Key="InkDark">#E2E8F0</Color>
  <Color x:Key="InkSecondaryDark">#A5B4CB</Color>
  <Color x:Key="InkMutedDark">#8A9AB5</Color>

  <!-- Status -->
  <Color x:Key="Success">#059669</Color>
  <Color x:Key="SuccessOnDark">#34D399</Color>
  <Color x:Key="Warning">#B45309</Color>
  <Color x:Key="WarningOnDark">#FBBF24</Color>
  <Color x:Key="DangerColor">#DC2626</Color>
  <Color x:Key="DangerOnDark">#F87171</Color>
  <Color x:Key="Info">#2563EB</Color>

  <!-- Kept for backward compatibility with older views / code -->
  <Color x:Key="Primary">#2563EB</Color>
  <Color x:Key="Danger">#DC2626</Color>

  <!-- Gradients -->
  <LinearGradientBrush x:Key="HeroGradient" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#14213D" Offset="0.0" />
    <GradientStop Color="#1E3A8A" Offset="0.6" />
    <GradientStop Color="#2563EB" Offset="1.0" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="TealGradient" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#0F766E" Offset="0.0" />
    <GradientStop Color="#14B8A6" Offset="1.0" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="SidebarGradient" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#14213D" Offset="0.0" />
    <GradientStop Color="#0C1529" Offset="1.0" />
  </LinearGradientBrush>

  <!-- Type scale -->
  <x:Double x:Key="FontDisplay">30</x:Double>
  <x:Double x:Key="FontH1">24</x:Double>
  <x:Double x:Key="FontH2">19</x:Double>
  <x:Double x:Key="FontH3">16</x:Double>
  <x:Double x:Key="FontBody">14</x:Double>
  <x:Double x:Key="FontCaption">12.5</x:Double>
  <x:Double x:Key="FontOverline">11</x:Double>

  <!-- Spacing -->
  <Thickness x:Key="PagePadding">16,16,16,24</Thickness>
  <x:Double x:Key="Gap">12</x:Double>
</ResourceDictionary>
